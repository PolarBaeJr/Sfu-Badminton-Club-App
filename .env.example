# === Required (build-time, baked into client bundle) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# === Required (runtime, server-side only) ===
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Optional (build-time) ===
NEXT_PUBLIC_APP_URL=http://your-pi-ip
NEXT_PUBLIC_PLAYER_URL=http://your-pi-ip
NEXT_PUBLIC_ADMIN_URL=http://your-pi-ip/admin
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# === Optional (runtime) ===
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
RESEND_API_KEY=

# === Pi deploy (proxy-manager routing) ===
# Hostname the proxy serves this stack on; set to the club domain when it arrives.
PROXY_DOMAIN=badminton.polardev.org
