# === Required (build-time, baked into client bundle) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# === Required (runtime, server-side only) ===
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Optional (build-time) ===
# Public URLs the apps are served on. Player at the apex, admin under /admin.
NEXT_PUBLIC_APP_URL=https://sfubadminton.com
NEXT_PUBLIC_PLAYER_URL=https://sfubadminton.com
# The console's OWN public base URL, path prefix included. Self-referential
# redirects are built from it, and its origin (path dropped) is what the passkey
# check compares against — so the path-mounted image gets the /admin here.
NEXT_PUBLIC_ADMIN_URL=https://admin.sfubadminton.com

# --- Second, path-mounted copy of the admin console (docker-compose service
# `admin-path`) ---
# Next bakes basePath in at build time, so serving the console at BOTH
# admin.sfubadminton.com and sfubadminton.com/admin needs two images from one
# source. The point of the second one: the player app is an installed PWA, and a
# PWA cannot keep a cross-origin navigation in its window, so linking execs to
# the subdomain throws them into a browser tab every time they open the console.
#
# These two are consumed only by the `admin-path` service; CI sets the same
# values from the matrix and the NEXT_PUBLIC_ADMIN_PATH_URL secret.
ADMIN_BASE_PATH=/admin
ADMIN_PATH_URL=https://sfubadminton.com/admin
# Where the PLAYER app's "Exec Panel" links point. Set to /admin once the
# admin-path service is live; leave empty and the links keep going to
# NEXT_PUBLIC_ADMIN_URL, exactly as before. Build-time (player image).
NEXT_PUBLIC_ADMIN_PATH=
# Domain a passkey is scoped to. Keep this the PARENT domain so one credential
# works on both the apex and the admin subdomain — and survives moving between
# them. Deriving it from the admin host instead invalidates every enrolled key.
NEXT_PUBLIC_PASSKEY_RP_ID=sfubadminton.com
# Domain the Supabase auth session cookie is scoped to. Set to the parent
# domain with a leading dot so ONE sign-in covers the player app and the admin
# console; leave it EMPTY (as here) for a host-only cookie — the original
# behaviour, and the only thing that works on localhost, where a ".localhost"
# domain is rejected by some browsers.
#
#   NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.sfubadminton.com
#
# Build-time, and it must be the same for BOTH images: the browser writes this
# cookie on every token refresh, so a server/browser or player/admin mismatch
# creates two cookies of the same name on different scopes. Setting it only in
# the Pi's runtime .env does nothing — it has to be a build arg.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# === Optional (runtime) ===
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
RESEND_API_KEY=
# Signs the admin passkey-gate cookies. Generate: openssl rand -base64 48
ADMIN_PASSKEY_COOKIE_SECRET=

# === Pi deploy (proxy-manager routing) ===
# Hostname the proxy serves this stack on (the club domain).
PROXY_DOMAIN=sfubadminton.com
# Admin console's own host. The second copy of the console is served under
# /admin on PROXY_DOMAIN above; longest-prefix matching in proxy-manager puts it
# ahead of the player app's "/".
ADMIN_PROXY_DOMAIN=admin.sfubadminton.com
