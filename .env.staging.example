# Staging environment — point at a SEPARATE Supabase project from prod.
# Copy to .env.staging on the Pi and fill in. Never commit the real .env.staging.

# === Required (build-time, baked into client bundle) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key

# === Required (runtime, server-side only) ===
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# === URLs — staging is served at https://test.polardev.org ===
# Cloudflare terminates TLS and proxies to the Pi on :80; nginx
# routes by Host header to the staging containers (3013/3014).
NEXT_PUBLIC_APP_URL=https://test.polardev.org
NEXT_PUBLIC_PLAYER_URL=https://test.polardev.org
NEXT_PUBLIC_ADMIN_URL=https://test.polardev.org/admin

# === Optional (build-time) ===
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# === Optional (runtime) ===
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
RESEND_API_KEY=

# === Pi deploy (proxy-manager routing) ===
PROXY_DOMAIN=badminton-staging.polardev.org
