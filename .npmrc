# Make `engines.node` a rule rather than a warning.
#
# Without this, engines is advisory: npm prints a notice and installs anyway.
# That is how the dev machine drifted to Node 26 while CI and the Pi ran 20,
# and why a suite that needed a global `WebSocket` (absent before Node 22)
# passed locally and failed during a production deploy.
#
# With engine-strict, `npm install`/`npm ci` exits non-zero on the wrong major,
# so the drift surfaces on the laptop at install time instead of in CI.
# Note this gates npm, not node: it cannot stop `vitest` running under a
# mismatched Node against an already-populated node_modules. Use `nvm use`
# (.nvmrc) for that.
engine-strict=true
